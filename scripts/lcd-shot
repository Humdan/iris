#!/usr/bin/env python3
"""lcd-shot [out.png] [--crop x0,y0,x1,y1] [--from raw]: save the Iris LCD as a PNG.

Reads /dev/fb0 (800x480 RGB565; needs the `video` group), or with --from a raw
frame written by `IRIS_SNAPSHOT=<raw> ./iris_fb` (preview a build without
touching the live screen). Default output: /tmp/lcd-<time>.png. Prints the path.
"""
import struct, sys, time, zlib

W, H = 800, 480
src = "/dev/fb0"
if "--from" in sys.argv:
    i = sys.argv.index("--from"); src = sys.argv[i + 1]; del sys.argv[i:i + 2]
args = [a for a in sys.argv[1:] if not a.startswith("--crop")]
crop = (0, 0, W, H)
for i, a in enumerate(sys.argv):
    if a.startswith("--crop"):
        val = a.split("=", 1)[1] if "=" in a else sys.argv[i + 1]
        crop = tuple(int(v) for v in val.split(","))
        if not a.count("=") and val in args:
            args.remove(val)
out = args[0] if args else time.strftime("/tmp/lcd-%H%M%S.png")
with open(src, "rb") as f:
    d = f.read(W * H * 2)
x0, y0, x1, y1 = crop
rows = []
for y in range(y0, y1):
    r = bytearray([0])
    for x in range(x0, x1):
        v = d[(y * W + x) * 2] | d[(y * W + x) * 2 + 1] << 8
        r += bytes((((v >> 11) & 31) * 255 // 31, ((v >> 5) & 63) * 255 // 63, (v & 31) * 255 // 31))
    rows.append(bytes(r))
chunk = lambda t, b: struct.pack(">I", len(b)) + t + b + struct.pack(">I", zlib.crc32(t + b) & 0xFFFFFFFF)
with open(out, "wb") as f:
    f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", x1 - x0, y1 - y0, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(b"".join(rows))) + chunk(b"IEND", b""))
print(out)
